// Reglas endurecidas (Fase 5): requieren sesión de Firebase Auth para todo,
// y restringen users/{uid} a lectura propia-o-admin, escritura solo-admin.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.admin == true;
    }

    match /users/{userId} {
      allow read: if estaAutenticado() && (request.auth.uid == userId || esAdmin());
      allow write: if esAdmin();
    }

    match /{coleccion}/{docId} {
      allow read, write: if estaAutenticado() && coleccion != 'users';
    }
  }
}
