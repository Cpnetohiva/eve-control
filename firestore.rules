// Reglas basadas en Roles (Fase 6): cada colección se gatea por el permiso
// denormalizado en users/{uid}.permisosResueltos[modulo] ('ninguno'|'lectura'|'escritura').
// PRERREQUISITO: users/{uid}.permisosResueltos debe existir para TODOS los usuarios
// antes de desplegar esto (Tarea 1 + migración). Si falta, el fallback es 'ninguno'
// (deniega, no permite) — evita fuga de datos pero también bloquea acceso legítimo
// si se despliega fuera de orden.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function permisoModulo(modulo) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('permisosResueltos', {}).get(modulo, 'ninguno');
    }

    function esAdminEscritura() {
      return estaAutenticado() && permisoModulo('admin') == 'escritura';
    }

    function puedeLeer(modulo) {
      return estaAutenticado() && (esAdminEscritura() || permisoModulo(modulo) in ['lectura', 'escritura']);
    }

    function puedeEscribir(modulo) {
      return estaAutenticado() && (esAdminEscritura() || permisoModulo(modulo) == 'escritura');
    }

    // Maquinas de estados de cotizaciones y ordenes de compra (espejo de TRANSICIONES en js/cotizaciones.js y
    // js/ordenescompra.js). Quedarse en el mismo estado solo se permite en Borrador / Emitida (edicion del documento).
    // Reemplazada solo se alcanza al crear una revision, y vuelve a Enviada o Rechazada al eliminarla.
    function transicionCotizacionValida(de, a) {
      return (de == 'Borrador' && a in ['Borrador', 'Enviada', 'Cancelada'])
        || (de == 'Enviada' && a in ['Aceptada', 'Rechazada', 'Cancelada', 'Reemplazada'])
        || (de == 'Aceptada' && a == 'Cancelada')
        || (de == 'Rechazada' && a == 'Reemplazada')
        || (de == 'Reemplazada' && a in ['Enviada', 'Rechazada']);
    }

    function transicionOrdenCompraValida(de, a) {
      return (de == 'Emitida' && a in ['Emitida', 'Recibida', 'Cancelada'])
        || (de == 'Recibida' && a == 'Cancelada');
    }

    match /users/{userId} {
      allow read: if estaAutenticado() && (request.auth.uid == userId || puedeLeer('admin'));
      allow write: if esAdminEscritura();
    }
    match /roles/{rolId} {
      allow read: if puedeLeer('admin');
      allow write: if esAdminEscritura();
    }

    match /destaraje/{docId} {
      allow read: if puedeLeer('destaraje');
      allow write: if puedeEscribir('destaraje');
    }

    match /pagos/{docId} {
      allow read: if puedeLeer('pagos');
      allow write: if puedeEscribir('pagos');
    }

    match /ministraciones/{docId} {
      allow read: if puedeLeer('pagos');
      allow write: if puedeEscribir('pagos');
    }

    match /proveedores/{docId} {
      allow read: if puedeLeer('cxp');
      allow write: if puedeEscribir('cxp');
    }

    match /comisiones/{docId} {
      allow read: if puedeLeer('cxp');
      allow write: if esAdminEscritura();
    }

    match /ventas/{docId} {
      allow read: if puedeLeer('ventas');
      allow write: if puedeEscribir('ventas');
    }

    match /composiciones/{docId} {
      allow read: if puedeLeer('ventas') || puedeLeer('rendimientos');
      allow write: if puedeEscribir('ventas');
    }

    match /cuentas_por_cobrar/{docId} {
      allow read: if puedeLeer('cxc');
      allow write: if puedeEscribir('cxc');
    }

    match /cobros/{docId} {
      allow read: if puedeLeer('cxc');
      allow write: if puedeEscribir('cxc');
    }

    // Flujo de efectivo: movimientos manuales (los cobros, pagos y gastos se leen de sus propias colecciones).
    // PREPARADA, SIN DESPLEGAR: el deploy de firestore.rules es un paso aparte con aprobación explícita.
    match /flujo_movimientos/{docId} {
      allow read: if puedeLeer('flujo');
      allow write: if puedeEscribir('flujo');
    }

    match /precios/{docId} {
      allow read: if puedeLeer('precios');
      allow write: if puedeEscribir('precios');
    }

    match /ajustes_precio_proveedor/{docId} {
      allow read: if puedeLeer('precios');
      allow write: if puedeEscribir('precios');
    }

    match /cuentas_por_pagar/{docId} {
      allow read: if puedeLeer('cxp');
      allow write: if puedeEscribir('cxp');
    }

    match /auditorias/{docId} {
      allow read: if puedeLeer('cxp');
      allow write: if puedeEscribir('cxp');
    }

    match /auditoria_fotos/{docId} {
      allow read: if puedeLeer('cxp');
      allow write: if puedeEscribir('cxp');
    }

    match /control_produccion/{docId} {
      allow read: if puedeLeer('control_produccion');
      allow write: if puedeEscribir('control_produccion');
    }

    match /gastos/{docId} {
      allow read: if puedeLeer('gastos');
      allow create: if puedeEscribir('gastos');
      allow update: if puedeEscribir('gastos');
      allow delete: if puedeEscribir('gastos');
    }

    // Alta siempre en Borrador; el estado solo cambia por las transiciones validas; solo se borra un Borrador.
    match /cotizaciones/{docId} {
      allow read: if puedeLeer('cotizaciones');
      allow create: if puedeEscribir('cotizaciones') && request.resource.data.estado == 'Borrador';
      allow update: if puedeEscribir('cotizaciones') && transicionCotizacionValida(resource.data.estado, request.resource.data.estado);
      allow delete: if puedeEscribir('cotizaciones') && resource.data.estado == 'Borrador';
    }

    // Alta siempre Emitida; Emitida -> Recibida | Cancelada, Recibida -> Cancelada; solo se borra una Emitida (una OC
    // nunca esta en Borrador, asi que el equivalente del Borrador de cotizaciones es Emitida).
    match /ordenes_compra/{docId} {
      allow read: if puedeLeer('ordenesCompra');
      allow create: if puedeEscribir('ordenesCompra') && request.resource.data.estado == 'Emitida';
      allow update: if puedeEscribir('ordenesCompra') && transicionOrdenCompraValida(resource.data.estado, request.resource.data.estado);
      allow delete: if puedeEscribir('ordenesCompra') && resource.data.estado == 'Emitida';
    }

    match /clientes_cotizacion/{docId} {
      allow read: if puedeLeer('cotizaciones');
      allow write: if puedeEscribir('cotizaciones');
    }

    // Contadores de folios consecutivos por anio (COT-AAAA-0001, OC-AAAA-0001). Cada prefijo lo toca solo quien tiene el
    // permiso de su modulo (COT- -> cotizaciones, OC- -> ordenesCompra); un id con otro prefijo solo lo toca Admin. Solo se puede
    // crear en 1 o subir de uno en uno: un usuario con escritura no puede retroceder el contador y provocar folios repetidos
    // (Admin puede corregirlo).
    match /contadores/{docId} {
      allow read: if esAdminEscritura()
        || (docId.matches('COT-.*') && puedeLeer('cotizaciones'))
        || (docId.matches('OC-.*') && puedeLeer('ordenesCompra'));
      allow create: if request.resource.data.ultimo == 1
        && (esAdminEscritura()
          || (docId.matches('COT-.*') && puedeEscribir('cotizaciones'))
          || (docId.matches('OC-.*') && puedeEscribir('ordenesCompra')));
      allow update: if esAdminEscritura()
        || (request.resource.data.ultimo == resource.data.ultimo + 1
          && ((docId.matches('COT-.*') && puedeEscribir('cotizaciones'))
            || (docId.matches('OC-.*') && puedeEscribir('ordenesCompra'))));
      allow delete: if esAdminEscritura();
    }

    match /inventario/{docId} {
      allow read: if puedeLeer('inventario');
      allow write: if puedeEscribir('inventario');
    }

    match /inventario_inicial/{docId} {
      allow read: if puedeLeer('inventario');
      allow write: if puedeEscribir('inventario');
    }

    match /config/{docId} {
      allow read: if estaAutenticado();
      allow write: if esAdminEscritura();
    }

    match /historial_cambios/{docId} {
      // Se escribe desde casi todos los módulos transaccionales (destaraje,
      // pagos, control_produccion, rendimientos, ventas, inventario,
      // admin-importar); se lee únicamente desde la subpestaña Historial en
      // el panel de Admin. Write abierta a cualquier autenticado (log
      // append-only, solo .add(), nunca update/delete — la acción ya pasó su
      // propio chequeo de permiso en el módulo de origen). Read restringida a
      // puedeLeer('admin'), que es donde se visualiza.
      allow read: if puedeLeer('admin');
      allow write: if estaAutenticado();
    }

    // Rendimientos, Reportes y Dashboard no tienen colección propia —
    // heredan el permiso de las colecciones subyacentes que consultan.

    match /recibos_pendientes/{docId} {
      allow read: if puedeLeer('cxp') || puedeLeer('pagos');
      allow create: if puedeEscribir('cxp');
      allow update: if puedeEscribir('cxp') || puedeEscribir('pagos');
      // Solo Admin puede borrar, y solo mientras sigue
      // pendiente de pago (nunca un recibo ya completado, para no perder el historial).
      allow delete: if resource.data.estado == 'pendiente_pago' && esAdminEscritura();
    }

    match /recibos_pago/{docId} {
      allow read: if puedeLeer('cxp') || puedeLeer('pagos');
      allow create: if puedeEscribir('pagos');
      allow update: if false;
      allow delete: if false;
    }
  }
}
